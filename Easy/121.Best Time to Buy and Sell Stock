class Solution:
    def maxProfit(self, prices: List[int]) -> int:
        minimum = prices[0]
        maximum_profit = 0
        for i in range(len(prices)):
            if(prices[i]<minimum):
                minimum=prices[i]
            if(prices[i]-minimum>maximum_profit):
                maximum_profit=prices[i]-minimum
        return maximum_profit
